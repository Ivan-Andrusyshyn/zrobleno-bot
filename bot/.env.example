# Скопіюй цей файл як .env і заповни значення.
# На Netlify ці ж змінні додаються в Site configuration → Environment variables.

BOT_TOKEN=""          # токен від @BotFather
ADMIN_CODE=""         # код, яким стаєш адміном бота: /admin КОД
WEBHOOK_SECRET=""     # будь-який довгий випадковий рядок
MONGODB_URI=""        # mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/
MONGODB_DB="zrobleno"
TIMEZONE="Europe/Kiev"
REACT_ON_CHECKIN="1"  # 1 — бот ставить 👍 на зараховану відмітку, 0 — ні
